<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة تحكم الأدمن</title>
    
    <!-- Bootstrap & FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-image: url('/student/img/bg-masthead.jpg'); /* نفس الخلفية الثابتة */
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-position: center;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* هيدر أنيق وبسيط مشابه للصورة */
        .admin-navbar {
            background-color: rgba(255, 255, 255, 0.95);
            box-shadow: 0 2px 4px rgba(0,0,0,.08);
            padding: 0.8rem 2rem;
        }

        .admin-navbar .navbar-brand {
            font-weight: 700;
            color: #212529 !important;
            font-size: 1.25rem;
        }

        .admin-navbar .nav-link {
            color: #495057 !important;
            font-weight: 500;
            transition: color 0.2s;
        }

        .admin-navbar .nav-link:hover {
            color: #0d6efd !important;
        }

        /* محتوى الصفحة */
        .main-content {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
        }

        /* فوتر بسيط */
        .admin-footer {
            background-color: rgba(255, 255, 255, 0.9);
            border-top: 1px solid #dee2e6;
            padding: 1rem 0;
            text-align: center;
            color: #6c757d;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- الهيدر (Navbar) -->
    <header>
        <nav class="navbar navbar-expand-lg admin-navbar fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">ToDoListApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="adminNavbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Tasks" asp-action="Index">Tasks</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- المحتوى الرئيسي -->
    <div class="main-content container">
        <main role="main" class="w-100">
            @RenderBody()
        </main>
    </div>

    <!-- الفوتر -->
    <footer class="admin-footer">
        <div class="container">
            &copy; 2026 - ToDoListApp Admin Panel - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>